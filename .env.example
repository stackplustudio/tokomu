# =============================================================================
# Maincore — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Pooled connection (used by Prisma at runtime via pgBouncer / Supabase pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true"

# Direct connection (used by Prisma Migrate — bypasses the pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Must be set in every environment. Application refuses to start without these.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_64_BYTE_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_SECURE_RANDOM_64_BYTE_HEX"

# JWT expiry durations (examples: 15m, 1h, 7d)
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV="development"       # development | production | test

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL of the Next.js frontend (no trailing slash)
FRONTEND_URL="http://localhost:3000"

# ── Supabase (optional — only if using Supabase Auth/Storage features) ────────
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SECRET_KEY="sb_secret_..."

